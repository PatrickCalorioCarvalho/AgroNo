<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- Mapa + camera ao vivo -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextureView
            android:id="@+id/videoView"
            android:layout_width="360dp"
            android:layout_height="203dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Painel de dados e acoes -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card"
            android:ellipsize="end"
            android:maxLines="4"
            android:padding="10dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- Acoes de planejamento -->
        <LinearLayout
            android:id="@+id/rowEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <Button android:id="@+id/btnMark" style="@style/PanelButton" android:text="Marcar canto (drone)" />

            <LinearLayout style="@style/PanelRow">
                <Button android:id="@+id/btnUndo" style="@style/PanelButtonHalf" android:text="Desfazer" />
                <Button android:id="@+id/btnClear" style="@style/PanelButtonHalf" android:text="Limpar" />
            </LinearLayout>

            <LinearLayout style="@style/PanelRow">
                <Button android:id="@+id/btnHome" style="@style/PanelButtonHalf" android:text="Ponto H" />
                <Button android:id="@+id/btnConfig" style="@style/PanelButtonHalf" android:text="Config" />
            </LinearLayout>

            <Button android:id="@+id/btnPlan" style="@style/PanelButtonPrimary" android:text="Gerar plano" />
        </LinearLayout>

        <!-- Acoes de missao -->
        <LinearLayout
            android:id="@+id/rowMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button android:id="@+id/btnStart" style="@style/PanelButtonPrimary" android:text="Iniciar missao" />

            <LinearLayout style="@style/PanelRow">
                <Button android:id="@+id/btnPause" style="@style/PanelButtonHalf" android:text="Pausar" />
                <Button android:id="@+id/btnResume" style="@style/PanelButtonHalf" android:text="Retomar" />
            </LinearLayout>

            <Button android:id="@+id/btnStop" style="@style/PanelButtonDanger" android:text="PARAR" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Atalhos -->
        <LinearLayout style="@style/PanelRow">
            <Button android:id="@+id/btnCenter" style="@style/PanelButtonThird" android:text="Centrar" />
            <Button android:id="@+id/btnVideo" style="@style/PanelButtonThird" android:text="Camera" />
            <Button android:id="@+id/btnMore" style="@style/PanelButtonThird" android:text="Mais" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
