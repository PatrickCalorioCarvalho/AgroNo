# Copie para .env (ignorado pelo git) e defina as credenciais do RustFS/S3.
AGRONO_S3_ACCESS_KEY=
AGRONO_S3_SECRET_KEY=
# Opcionais
AGRONO_S3_BUCKET=agrono-drone
AGRONO_FLY_API_PORT=8000
AGRONO_FLY_S3_PORT=9000
AGRONO_FLY_CONSOLE_PORT=9001
# Opcional: resolucao do mosaico em cm/pixel (vazio = o ODM escolhe pelo GSD das fotos)
ODM_ORTHO_RES_CM=
